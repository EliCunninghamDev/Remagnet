# Bridge credential used by the extension. Generate with:
#   openssl rand -hex 32
BRIDGE_TOKEN=

# Where the bridge reaches qBittorrent. On the server this is usually the
# gluetun container that shares qBittorrent's network namespace.
QBIT_BASE_URL=http://gluetun:8080

# qBittorrent 5.2+ API key (recommended). Leave username/password empty when
# this is set. The config page can replace these after the first boot.
QBIT_API_KEY=
QBIT_USERNAME=
QBIT_PASSWORD=
