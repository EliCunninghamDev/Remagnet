# Proxy bearer token used by the browser extension and Android app. Generate
# with: openssl rand -hex 32
BRIDGE_TOKEN=

# Where the bridge reaches qBittorrent. On the server this is usually the
# gluetun container that shares qBittorrent's network namespace.
QBIT_BASE_URL=http://gluetun:8080

# qBittorrent 5.2+ API key (recommended). Leave username/password empty when
# this is set. The config page can replace these after the first boot. The proxy
# boots without credentials and reports setup as incomplete until they are set.
QBIT_API_KEY=
QBIT_USERNAME=
QBIT_PASSWORD=

# Category and tags applied to every magnet added through the proxy. These also
# decide which torrents the proxy lists and allows clients to delete. Tags are
# comma-separated, trimmed, and deduplicated. Leave both blank to expose every
# torrent in qBittorrent.
REMAGNET_CATEGORY=remagnet
REMAGNET_TAGS=remagnet
