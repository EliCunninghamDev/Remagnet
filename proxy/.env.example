# Optional one-time code that lets the first visitor create the admin account.
# Remove it (or leave it blank) once the account exists. Generate with:
# openssl rand -hex 16
SETUP_CODE=

# Which torrent client the proxy adapts: qbittorrent, transmission, deluge, or
# rtorrent. rutorrent is accepted as an alias for rtorrent. The config page can
# switch clients after the first boot unless CLIENT_KIND is set here.
CLIENT_KIND=qbittorrent

# Where the proxy reaches the torrent client. On the server this is usually the
# gluetun container that shares qBittorrent's network namespace, a Transmission
# RPC endpoint, Deluge's Web UI, or rTorrent's XML-RPC endpoint (/RPC2 or
# ruTorrent's /plugins/rpc/rpc.php).
#
# Defaults when unset: qbittorrent http://gluetun:8080,
# transmission http://transmission:9091, deluge http://deluge:8112, and
# rtorrent http://rtorrent:8000.
CLIENT_BASE_URL=http://gluetun:8080
# CLIENT_BASE_URL=http://transmission:9091
# CLIENT_BASE_URL=http://deluge:8112
# CLIENT_BASE_URL=http://rtorrent:8000

# qBittorrent 5.2+ API key (recommended). Leave the username and password empty
# when this is set. The config page can replace these after the first boot. The
# proxy boots without credentials and reports setup as incomplete until they
# are set.
#
# Transmission and rTorrent often run without authentication on a private
# network, so only CLIENT_BASE_URL is required for them. Deluge always needs
# its Web UI password. CLIENT_USERNAME and CLIENT_PASSWORD are shared by the
# clients that use credentials. DELUGE_PASSWORD supplies the Deluge password
# when CLIENT_PASSWORD is blank.
QBIT_API_KEY=
CLIENT_USERNAME=
CLIENT_PASSWORD=
# DELUGE_PASSWORD=deluge

# Optional read-only mount of the torrent client's downloads volume. Point this
# at the directory on the proxy that contains the client's completed files;
# without it, the proxy still manages torrents but ZIP archive downloads are
# disabled. Transmission, Deluge, and rTorrent read files from this mount.
# qBittorrent streams through its Web API when the API is new enough, so the
# mount is only a fallback there.
DOWNLOADS_DIR=

# Optional prefix of torrent download paths as the torrent client reports them,
# for example /data/torrents. The proxy strips this prefix before resolving a
# file inside DOWNLOADS_DIR. Leave it blank when both paths are the same.
CLIENT_DOWNLOADS_DIR=

# Category and tags applied to every magnet added through the proxy. These also
# decide which torrents the proxy lists and allows clients to delete.
#
# qBittorrent uses both: REMAGNET_CATEGORY=remagnet and REMAGNET_TAGS=remagnet.
# Transmission uses tags as labels and ignores the category:
# REMAGNET_CATEGORY= (blank) and REMAGNET_TAGS=remagnet.
# Deluge and rTorrent use the category as a single label (created if missing)
# and ignore tags: REMAGNET_CATEGORY=remagnet and REMAGNET_TAGS= (blank).
#
# Tags are comma-separated, trimmed, and deduplicated. Leave both blank to
# expose every torrent.
REMAGNET_CATEGORY=remagnet
REMAGNET_TAGS=remagnet
