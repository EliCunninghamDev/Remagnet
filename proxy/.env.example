# Optional one-time code that lets the first visitor create the admin account.
# Remove it (or leave it blank) once the account exists. Generate with:
# openssl rand -hex 16
SETUP_CODE=

# Which torrent client the proxy adapts: qbittorrent or transmission.
CLIENT_KIND=qbittorrent

# Where the proxy reaches the torrent client. On the server this is usually the
# gluetun container that shares qBittorrent's network namespace, or the
# Transmission container's RPC endpoint. QBIT_BASE_URL and
# TRANSMISSION_BASE_URL are accepted as older aliases.
CLIENT_BASE_URL=http://gluetun:8080
# CLIENT_BASE_URL=http://transmission:9091
# QBIT_BASE_URL=http://gluetun:8080
# TRANSMISSION_BASE_URL=http://transmission:9091

# qBittorrent 5.2+ API key (recommended). Leave the username and password empty
# when this is set. The config page can replace these after the first boot. The
# proxy boots without credentials and reports setup as incomplete until they
# are set.
#
# Transmission often runs without authentication on a private network, so only
# CLIENT_BASE_URL is required for it. CLIENT_USERNAME and CLIENT_PASSWORD are
# shared by both clients; QBIT_USERNAME and QBIT_PASSWORD are older aliases.
QBIT_API_KEY=
CLIENT_USERNAME=
CLIENT_PASSWORD=
# QBIT_USERNAME=
# QBIT_PASSWORD=

# Optional read-only mount of the torrent client's downloads volume. Point this
# at the directory on the proxy that contains the client's completed files;
# without it, the proxy still manages torrents but ZIP archive downloads are
# disabled.
DOWNLOADS_DIR=

# Optional prefix of torrent download paths as the torrent client reports them,
# for example /data/torrents. The proxy strips this prefix before resolving a
# file inside DOWNLOADS_DIR. Leave it blank when both paths are the same.
CLIENT_DOWNLOADS_DIR=

# Category and tags applied to every magnet added through the proxy. These also
# decide which torrents the proxy lists and allows clients to delete. Tags are
# comma-separated, trimmed, and deduplicated. Transmission uses tags as labels
# and ignores the category. Leave both blank to expose every torrent.
REMAGNET_CATEGORY=remagnet
REMAGNET_TAGS=remagnet
