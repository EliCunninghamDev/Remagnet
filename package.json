{
  "name": "remagnet",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/extension dev",
    "dev:firefox": "bun run --cwd apps/extension dev:firefox",
    "urls:firefox": "bun run --cwd apps/extension urls",
    "build": "bun run --cwd apps/extension build",
    "build:firefox": "bun run --cwd apps/extension build:firefox",
    "zip": "bun run --cwd apps/extension zip",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "postinstall": "bun run --cwd apps/extension postinstall"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
