{
  "name": "remagnet",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd extension dev",
    "dev:firefox": "bun run --cwd extension dev:firefox",
    "urls:firefox": "bun run --cwd extension urls",
    "build": "bun run --cwd extension build",
    "build:firefox": "bun run --cwd extension build:firefox",
    "zip": "bun run --cwd extension zip",
    "zip:firefox": "bun run --cwd extension zip:firefox",
    "version:check": "bun run scripts/version.ts check",
    "version:set": "bun run scripts/version.ts set",
    "test": "bun run test:unit && bun run test:ui",
    "test:unit": "bun test",
    "test:ui": "bun run --cwd extension test:ui",
    "api:generate": "bun run scripts/generate-api-clients.ts",
    "banner:generate": "bun run scripts/generate-banner.ts",
    "site:build": "bun run scripts/build-site.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "android:build": "./android/gradlew -p android :app:assembleDebug",
    "android:test": "./android/gradlew -p android :app:testDebugUnitTest",
    "postinstall": "bun run --cwd extension postinstall"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@types/bun": "^1.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
