{
  "name": "remagnet",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd extension dev",
    "dev:firefox": "bun run --cwd extension dev:firefox",
    "urls:firefox": "bun run --cwd extension urls",
    "build": "bun run --cwd extension build",
    "build:firefox": "bun run --cwd extension build:firefox",
    "zip": "bun run --cwd extension zip",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "android:build": "./android/gradlew -p android :app:assembleDebug",
    "android:test": "./android/gradlew -p android :app:testDebugUnitTest",
    "postinstall": "bun run --cwd extension postinstall"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
